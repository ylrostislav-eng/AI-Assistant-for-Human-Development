{
  "name": "@system/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "API, CommandBus и worker персональной ИИ-Системы развития",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "tsx src/server.ts",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit tests/contracts",
    "test:integration": "vitest run tests/integration",
    "test:shuffle": "vitest run tests/integration --sequence.shuffle",
    "migrate": "tsx src/shared/db/migrate.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.4",
    "pg": "8.23.0"
  },
  "devDependencies": {
    "@types/node": "22.20.2",
    "@types/pg": "8.23.1",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "vitest": "5.0.1",
    "yaml": "2.9.1"
  }
}
