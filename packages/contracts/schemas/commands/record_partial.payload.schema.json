{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://contracts.system.local/commands/record_partial.payload.schema.json",
  "title": "RecordPartialPayloadDraftV1",
  "description": "Partial progress. The measured amount is required: without it a partial is indistinguishable from nothing done.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "occurrence_id": { "type": "string", "format": "uuid" },
    "expected_version": { "type": "integer", "minimum": 0 },
    "occurred_start": { "type": "string", "format": "date-time" },
    "occurred_end": { "type": "string", "format": "date-time" },
    "actual_duration_seconds": { "type": "integer", "minimum": 0, "maximum": 86400 },
    "actual_amount": { "type": "number", "minimum": 0, "maximum": 1000000 },
    "source": { "enum": ["self", "timer", "device", "import"] }
  }
}
