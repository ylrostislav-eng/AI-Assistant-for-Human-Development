# Пример переменных окружения. Настоящие значения в git не попадают (AGENTS.md).
# Скопировать в .env локально или задать переменные в окружении сервера.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Отдельная база для разработки и отдельная для тестов: интеграционные тесты
# удаляют свои таблицы, и направлять их на рабочую базу нельзя.
DATABASE_URL=postgres://system:ЗАМЕНИТЬ@127.0.0.1:5432/system_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Вход по синтетической личности без внешнего провайдера. Только для
# разработки: при NODE_ENV=production запуск с этим флагом отклоняется.
DEV_AUTH_ENABLED=false

# Вход через Telegram Mini App. Без токена маршрут /auth/telegram отвечает 404:
# включать проверку подписи наполовину нельзя.
#
# Токен выдаёт @BotFather. Он не попадает ни в git, ни в логи, ни клиенту;
# засветившийся токен отзывается командой /revoke у BotFather.
TELEGRAM_BOT_TOKEN=

# Список допущенных к пилоту Telegram user ID через запятую. Пустой список
# означает «никого»: доступ закрыт по умолчанию. Свой ID можно узнать у
# @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Срок жизни подписанной строки initData и допустимое расхождение часов вперёд.
# Подпись не делает украденную строку безопасной, окно кражи сужает только срок.
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=30
