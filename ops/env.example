# Пример переменных окружения. Настоящие значения в git не попадают (AGENTS.md).
# Скопировать в .env локально или задать переменные в окружении сервера.

NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Отдельная база для разработки и отдельная для тестов: интеграционные тесты
# удаляют свои таблицы, и направлять их на рабочую базу нельзя.
DATABASE_URL=postgres://system:ЗАМЕНИТЬ@127.0.0.1:5432/system_dev
DATABASE_POOL_MAX=10
DATABASE_CONNECT_TIMEOUT_MS=5000

# Вход по синтетической личности без внешнего провайдера. Только для
# разработки: при NODE_ENV=production запуск с этим флагом отклоняется.
DEV_AUTH_ENABLED=false

# Вход через Telegram Mini App. Без токена маршрут /auth/telegram отвечает 404:
# включать проверку подписи наполовину нельзя.
#
# Токен выдаёт @BotFather. Он не попадает ни в git, ни в логи, ни клиенту;
# засветившийся токен отзывается командой /revoke у BotFather.
TELEGRAM_BOT_TOKEN=

# Список допущенных к пилоту Telegram user ID через запятую. Пустой список
# означает «никого»: доступ закрыт по умолчанию. Свой ID можно узнать у
# @userinfobot.
TELEGRAM_ALLOWED_USER_IDS=

# Секрет вебхука. Это НЕ токен бота: Telegram присылает его заголовком и им
# подтверждается только происхождение запроса. Задаётся при установке вебхука
# и должен совпадать с тем, что передан Telegram. Без него маршрут
# /telegram/webhook отвечает 404.
TELEGRAM_WEBHOOK_SECRET=

# Срок жизни подписанной строки initData и допустимое расхождение часов вперёд.
# Подпись не делает украденную строку безопасной, окно кражи сужает только срок.
TELEGRAM_AUTH_MAX_AGE_SECONDS=300
TELEGRAM_AUTH_FUTURE_SKEW_SECONDS=30

# Доступ к модели. Без AI_API_KEY ИИ просто нет, и это рабочее состояние:
# /new, /today и кнопки обязаны работать без модели (ADR-011). Если ключ задан,
# адрес и основная модель обязательны — наполовину настроенный ИИ выглядит
# рабочим до первого хода и падает уже в разговоре с человеком.
#
# Ключ не попадает ни в git, ни в логи, ни клиенту. Оператор шлюза, через
# который куплен доступ, видит всё, что уходит модели.
AI_API_KEY=

# Адрес поставщика, обязательно https: ключ уходит заголовком, и без шифрования
# его прочитает любой посредник по дороге. Для купленного шлюза — с /v1 на
# конце: OpenAI-совместимая форма идёт в /v1/chat/completions, родная форма
# Anthropic — в /v1/messages, путь дописывается сам.
AI_BASE_URL=https://api.smartapi.shop/v1

# Модели задаются именами из списка поставщика целиком. Формат запроса по ним
# выбирается сам, по семейству: claude-* идёт родной формой Anthropic.
# Отправка claude-* в OpenAI-совместимый вход даёт отказ, неотличимый от сбоя
# поставщика, — это уже стоило вечера (docs/13-handoff.md, раздел 6.1).
AI_CHAT_MODEL=claude-sonnet-5

# Модель для редких тяжёлых задач. Пусто — используется AI_CHAT_MODEL.
AI_PLAN_MODEL=claude-opus-5

# Запасная модель на случай отказа основной. Обязательно другого семейства:
# 17 сентября вся линия Claude лежала разом, пока gpt-6-astra отвечал. Запас из
# того же семейства падает вместе с основной моделью и даёт лишь видимость
# запаса, поэтому запуск с ним отклоняется. Пусто — перебора нет.
AI_FALLBACK_MODEL=gpt-6-astra

# Границы одного запроса. Ответ модели невелик, но предел нужен до чтения:
# неограниченное тело съедает память раньше, чем станет ясно, что оно чужое.
AI_TIMEOUT_MS=30000
AI_MAX_OUTPUT_TOKENS=1024
